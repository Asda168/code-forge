      },
      {
        "prefix": "fetch",
        "body": "const res = await fetch(${1:url});\nconst data = await res.json();",
        "description": "fetch json"
      },
      {
        "prefix": "imp",
        "body": "import ${1:name} from '${2:module}';",
        "description": "import"
      }
    ],
    "typescript": [
      {
        "prefix": "clg",
        "body": "console.log($1);",
        "description": "log"
      },
      {
        "prefix": "iface",
        "body": "interface ${1:Name} {\n\t$0\n}",
