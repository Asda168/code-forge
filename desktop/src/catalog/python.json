{
  "id": "python",
  "name": "Python Snippets",
  "version": "1.0.0",
  "description": "Python helpers",
  "snippets": {
    "python": [
      {
        "prefix": "def",
        "body": "def ${1:name}(${2}):\n\t${0:pass}",
        "description": "function"
      },
      {
        "prefix": "class",
        "body": "class ${1:Name}:\n\tdef __init__(self${2}):\n\t\t${0:pass}",
        "description": "class"
      },
      {
        "prefix": "main",
        "body": "if __name__ == '__main__':\n\t${0:main()}",
        "description": "main guard"
      },
      {
        "prefix": "with",
        "body": "with open(${1:path}) as f:\n\t$0",
        "description": "open file"
      }
    ]
  }
}