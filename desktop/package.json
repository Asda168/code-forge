{
  "name": "codeforge",
  "productName": "Asta",
  "version": "1.3.4",
  "description": "Asta - Code. Build. Run. Ship.",
  "main": "src/main.js",
  "author": {
    "name": "Asta",
    "email": "Asda168@users.noreply.github.com"
  },
  "homepage": "https://github.com/Asda168/code-forge",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/make-icons.js",
    "dist:win": "electron-builder --win --x64 && electron-builder --win --arm64",
    "dist:win:x64": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac --universal",
    "dist:linux": "electron-builder --linux AppImage deb rpm",
    "shortcut": "node scripts/make-shortcut.js",
    "predist:win": "npm run icons",
    "predist:mac": "npm run icons",
    "predist:linux": "npm run icons"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "monaco-editor": "^0.52.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "sharp": "^0.33.0"
  },
  "build": {
    "appId": "dev.codeforge.app",
    "productName": "Asta",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "assets/**",
      "node_modules/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/node-pty/**"
    ],
    "fileAssociations": [
      {
        "ext": "*",
        "name": "File",
        "role": "Editor"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis",
      "artifactName": "Asta-Setup-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "include": "scripts/installer.nsh",
      "shortcutName": "Asta",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "Asta-macOS-universal.${ext}"
    },
    "linux": {
      "icon": "assets/icons/png",
      "category": "Development",
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "pacman"
      ],
      "artifactName": "Asta.${ext}",
      "maintainer": "Asta <Asda168@users.noreply.github.com>",
      "desktop": {
        "Name": "Asta",
        "Comment": "Code. Build. Run. Ship.",
        "Categories": "Development;IDE;TextEditor;",
        "MimeType": "inode/directory;text/plain;"
      }
    },
    "npmRebuild": false,
    "afterPack": "scripts/afterPack.js"
  }
}