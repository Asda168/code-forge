{
  "name": "codeforge",
  "productName": "CodeForge",
  "version": "1.0.0",
  "description": "CodeForge - Code. Build. Run. Ship.",
  "main": "src/main.js",
  "author": "CodeForge",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/make-icons.js",
    "dist:win": "electron-builder --win --x64 --arm64",
    "dist:mac": "electron-builder --mac --universal",
    "dist:linux": "electron-builder --linux AppImage deb rpm",
    "shortcut": "node scripts/make-shortcut.js",
    "predist:win": "npm run icons",
    "predist:mac": "npm run icons",
    "predist:linux": "npm run icons"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "monaco-editor": "^0.52.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "sharp": "^0.33.0"
  },
  "build": {
    "appId": "dev.codeforge.app",
    "productName": "CodeForge",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "assets/**",
      "node_modules/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/node-pty/**"
    ],
    "fileAssociations": [
      {
        "ext": "*",
        "name": "File",
        "role": "Editor"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "CodeForge-Setup-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "include": "scripts/installer.nsh",
      "shortcutName": "CodeForge",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "CodeForge-macOS-universal.${ext}"
    },
    "linux": {
      "icon": "assets/icons/png",
      "category": "Development",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "artifactName": "CodeForge.${ext}",
      "desktop": {
        "Name": "CodeForge",
        "Comment": "Code. Build. Run. Ship.",
        "Categories": "Development;IDE;TextEditor;",
        "MimeType": "inode/directory;text/plain;"
      }
    }
  }
}